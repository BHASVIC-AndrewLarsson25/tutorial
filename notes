// programs are made from objects
// objects contain attributes and methods
// objects are created from classes

// creates a class called player that inherits the methods and attributes from the actor(parent) class
// the Actor class has an act(); method in it that the player clas is able to use
public class Player extends Actor
{
...
}

// a constructor runs when an object is created
// it makes the object
Player player1 = new Player();
'classname' 'name' = new 'classname'();

public class Player extends Actor
{
    // constructor method
    public Player(health, damage)
    {
    // sets the heath of the object to whatever you pass as a paramiter
    this.health = heath;
    // objects attribute = paramiter;
    }
}

// a class is a blueprint for creating objects
// it describes what an object has and what it can do

public class Enemy // the name
{
    // a variable stored inside the class
    int health = 100;

    // method stored inside the class that can be used else were as it is public
    public void attack()
    {
    ...
    }
}
// a class can have: attributes, methods and constructors

// an object is an instance of a class
// it is a usable version of the blueprint, like an actual house
// they can use attributes and methods e.g. int health = 100; or attack(damage, enemy_health);

// attributes are variables stored inside an object
// they describe the object's characteristics

// methods are actions an object can perform
// they contain instructions


// encapsulation: keeping data protected inside a class from being accidently modified or deleted
// other classes access it using public methods

// anyone can change health directly which can cause problems later on and make it very difficult to debug
public int health;

// this is better
private int health;

// public method to change health that can be called/used in any object
public void take_damage(amount)
{
    health = health - amount;
}


// polymorphism: the same method can behave differently depending on the object
public class Enemy
{
    public void attack()
    {
    ...
    }
}
bat.attack();
bob.attack();
// bat will use the attack method differently than bob
// the bats bite might inflic a poison status effect, whereas bob might deal x3 damage as the shoot paramiter could have an effect like that in the method
// the act(); method is another big example


// sequencing is the spercific order of instructions
// one instruction runs after another
move(5);
turn(4);
checkWall(); etc

// selection allows a program to make decisions
// it uses conditions
if(checkWall() == true)
{
    player.heath = 0;
}

// if, else if, else, switch

switch(level)
{
    case 1:
        // code if the level is 1
    break;
    default:
        // code if the level is not 1 or any other case
    break;
}


// iteration is the repetition of code while a condition is met
// it is used when something needs to happen multiple times

// repeats code a set number of times
for(int i = 0; i < 10; i++)
{
    // code repeats 10 times
}
// used for creating multiple enemies when you know how many iterations you want

// repeats while a condition is true
while(health > 0)
{
    // game continues
}
// used when you don't know how many iterations you want

// runs once before checking the condition
do
{
    // code runs
}
while(health > 0);

// code inside never stops
while(true)
{
...
}

// the act() method of Actor is automatically a repleating loop aswell and will repeat every frame
