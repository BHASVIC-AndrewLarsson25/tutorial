// creates a player that can jump and move
public class Player extends Actor
{
    // stores the player's vertical speed
    int velocity = 0;

    // controls gravity strength
    int gravity = 1;

    public void act()
    {
        // applies gravity
        velocity = velocity + gravity;

        // moves player vertically
        setLocation(
        getX(),
        getY()+velocity
        );

        // controls movement
        movement();

        // checks if player landed on a platform
        checkPlatform();
    }

    // controls left, right and jumping
    public void movement()
    {
        // checks if left key is pressed
        if(Greenfoot.isKeyDown("left"))
        {
            // moves player left
            setLocation(getX()-5,getY());
        }

        // checks if right key is pressed
        if(Greenfoot.isKeyDown("right"))
        {
            // moves player right
            setLocation(getX()+5,getY());
        }

        // checks if space key is pressed
        if(Greenfoot.isKeyDown("space"))
        {
            // makes player jump upwards
            velocity = -15;
        }
    }

    // checks if player touches a platform
    public void checkPlatform()
    {
        // checks for platform collision
        if(isTouching(Platform.class))
        {
            // stops falling
            velocity = 0;

            // moves player slightly upwards
            setLocation(getX(),getY()-5);
        }
    }
}

