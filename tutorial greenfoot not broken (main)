// creates an enemy alien
public class Enemy extends Actor
{
    // stores enemy health
    int health = 1;

    public void act()
    {
        // moves the enemy downwards
        setLocation(getX(),getY()+2);

        // checks if the enemy reaches the bottom
        if(getY() > 390)
        {
            // removes the enemy
            getWorld().removeObject(this);
        }
    }

    // method for taking damage
    public void damage()
    {
        // reduces enemy health
        health = health - 1;

        // checks if health is zero
        if(health <= 0)
        {
            // removes enemy
            getWorld().removeObject(this);
        }
    }
}

