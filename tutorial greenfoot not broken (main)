// creates an object that follows the mouse
public class MouseObject extends Actor
{
    public void act()
    {
        // gets information about the mouse
        MouseInfo mouse = Greenfoot.getMouseInfo();

        // checks that the mouse exists
        if(mouse != null)
        {
            // stores the mouse x position
            int mouseX = mouse.getX();

            // stores the mouse y position
            int mouseY = mouse.getY();

            // moves the object to the mouse position
            setLocation(mouseX,mouseY);
        }
    }
}

// creates a player that aims using the mouse
public class GunPlayer extends Actor
{
    public void act()
    {
        // gets mouse information
        MouseInfo mouse = Greenfoot.getMouseInfo();

        // checks that the mouse exists
        if(mouse != null)
        {
            // turns the player towards the mouse
            turnTowards(
            mouse.getX(),
            mouse.getY()
            );
        }

        // checks if the mouse is clicked
        if(Greenfoot.mouseClicked(null))
        {
            // creates a bullet
            shoot();
        }
    }

    // creates a shooting method
    public void shoot()
    {
        // creates a new bullet
        Bullet bullet = new Bullet();

        // adds the bullet into the world
        getWorld().addObject(
        bullet,
        getX(),
        getY()
        );

        // makes the bullet travel the same way the player faces
        bullet.setRotation(getRotation());
    }
}

// creates bullets that can hit enemies
public class Bullet extends Actor
{
    public void act()
    {
        // moves the bullet forward
        move(8);

        // checks if the bullet hits an enemy
        if(isTouching(Enemy.class))
        {
            // removes the enemy
            removeTouching(Enemy.class);

            // removes the bullet
            getWorld().removeObject(this);
        }
    }
}

