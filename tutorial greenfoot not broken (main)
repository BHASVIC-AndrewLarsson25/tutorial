        }

        // checks if the space key is pressed
        if(Greenfoot.isKeyDown("space"))
        {
            // creates a bullet
            shoot();
        }
    }

    // creates a bullet from the player
    public void shoot()
    {
        // creates a new bullet object
        Bullet bullet = new Bullet();

        // places the bullet above the player
        getWorld().addObject(
        bullet,
        getX(),
        getY()-30
        );
    }
}

