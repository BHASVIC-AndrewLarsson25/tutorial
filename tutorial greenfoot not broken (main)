// asteroids game

// creates a spaceship that can rotate and shoot
public class Spaceship extends Actor
{
    public void act()
    {
        // checks if left key is pressed
        if(Greenfoot.isKeyDown("left"))
        {
            // rotates spaceship left
            turn(-5);
        }

        // checks if right key is pressed
        if(Greenfoot.isKeyDown("right"))
        {
            // rotates spaceship right
            turn(5);
        }

        // checks if up key is pressed
        if(Greenfoot.isKeyDown("up"))
        {
            // moves spaceship forward
            move(5);
        }

        // checks if mouse is clicked
        if(Greenfoot.mouseClicked(null))
        {
            // fires a bullet
            fire();
        }
    }

    // creates a bullet
    public void fire()
    {
        // creates a new bullet
        Bullet bullet = new Bullet();

        // adds bullet to the world
        getWorld().addObject(
        bullet,
        getX(),
        getY()
        );

        // makes bullet face the spaceship direction
        bullet.setRotation(getRotation());
    }
}

