// maze game

// creates a player object that can move around the maze
public class Player extends Actor
{
    public void act()
    {
        // checks if the right key is pressed
        if(Greenfoot.isKeyDown("right"))
        {
            // moves the player right
            setLocation(getX()+3,getY());
        }

        // checks if the left key is pressed
        if(Greenfoot.isKeyDown("left"))
        {
            // moves the player left
            setLocation(getX()-3,getY());
        }

        // checks if the up key is pressed
        if(Greenfoot.isKeyDown("up"))
        {
            // moves the player upwards
            setLocation(getX(),getY()-3);
        }

        // checks if the down key is pressed
        if(Greenfoot.isKeyDown("down"))
        {
            // moves the player downwards
            setLocation(getX(),getY()+3);
        }
        // checks if the player hits a wall
        checkWall();
    }

    // checks for collisions with walls
    public void checkWall()
    {
        // checks if the player is touching a wall
        if(isTouching(Wall.class))
        {
            // changes the player image when a wall is hit
            setImage("player-hit.png");

            // moves the player away from the wall
            move(-5);
        }

        else
        {
            // changes the image back to normal
            setImage("player.png");
        }
    }
}

