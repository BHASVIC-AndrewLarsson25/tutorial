// tower defence

// creates an enemy that travels towards the base
public class Enemy extends Actor
{
    // stores enemy health
    int health = 100;

    public void act()
    {
        // moves enemy along the path
        move(2);

        // checks if enemy is hit by a bullet
        checkBullet();

        // checks if enemy reaches the base
        checkBase();
    }

    // checks for bullet collisions
    public void checkBullet()
    {
        // checks if a bullet touches the enemy
        if(isTouching(Bullet.class))
        {
            // removes some health
            health = health - 25;

            // removes the bullet
            removeTouching(Bullet.class);

            // checks if enemy health reaches zero
            if(health <= 0)
            {
                // removes the enemy
                getWorld().removeObject(this);
            }
        }
    }

    // checks if enemy reaches the base
    public void checkBase()
    {
        // checks if the enemy touches the base
        if(isTouching(Base.class))
        {
            // removes the enemy
            getWorld().removeObject(this);
        }
    }
}

// creates a tower that shoots enemies
public class Tower extends Actor
{
    // controls how often the tower fires
    int reload = 0;

    public void act()
    {
        // reduces the reload timer
        reload--;

        // checks if the tower can shoot
        if(reload <= 0)
        {
            // searches for a nearby enemy
            Enemy enemy =
            (Enemy)getOneObjectAtOffset(100,0,Enemy.class);

            // checks if an enemy exists
            if(enemy != null)
            {
                // creates a bullet
                shoot();

                // resets reload time
                reload = 60;
            }
        }
    }


    // creates a bullet
    public void shoot()
    {
        // creates a new bullet object
        Bullet bullet = new Bullet();

        // adds bullet into the world
        getWorld().addObject(
        bullet,
        getX(),
        getY()
        );
    }
}

// creates bullets used by towers
public class Bullet extends Actor
{
    public void act()
    {
        // moves the bullet forward
        move(5);

        // checks if the bullet hits an enemy
        if(isTouching(Enemy.class))
        {
            // finds the enemy that was hit
            Enemy enemy =
            (Enemy)getOneIntersectingObject(Enemy.class);

            // removes enemy health
            enemy.health = enemy.health - 25;

            // removes the bullet
            getWorld().removeObject(this);
        }
    }
}

