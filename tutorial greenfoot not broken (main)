// covid game

// creates a person that moves around the simulation
public class Person extends Actor
{
    // stores the movement speed
    int speed = 2;

    // stores whether the person is infected
    boolean infected = false;

    public void act()
    {
        // moves the person forward
        move(speed);

        // creates random movement
        randomMove();

        // checks if the person catches the virus
        checkInfection();

        // checks if people are too close
        checkDistance();
    }

    // creates random movement
    public void randomMove()
    {
        // creates a random turning value
        int randomTurn = Greenfoot.getRandomNumber(21)-10;

        // turns the person randomly
        turn(randomTurn);
    }

    // checks if the person touches an infected person
    public void checkInfection()
    {
        // checks for contact with an infected person
        if(isTouching(InfectedPerson.class))
        {
            // changes the person to infected
            infected = true;

            // changes the image to show infection
            setImage("infected.png");
        }
    }

    // checks if another person is too close
    public void checkDistance()
    {
        // looks for nearby people
        Person other =
        (Person)getOneIntersectingObject(Person.class);

        // checks if another person is found
        if(other != null)
        {
            // moves away to create distance
            move(-2);
        }
    }
}

