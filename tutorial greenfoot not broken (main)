// creates the maze game world
public class MazeWorld extends World
{
    // runs when the world is created
    public MazeWorld()
    {
        // creates a world that is 600 pixels wide and 400 pixels high
        super(600,400,1);

        // creates the player at the starting position
        addObject(new Player(),100,100);

        // creates walls inside the maze
        addObject(new Wall(),200,100);
        addObject(new Wall(),200,200);
    }
}

// creates a method for changing images after collisions
public void checkWall()
{
    // checks if the player touches a wall
    if(isTouching(Wall.class))
    {
        // changes the image to show damage
        setImage("crashed.png");
    }

    else
    {
        // changes the image back when safe
        setImage("player.png");
    }
}

